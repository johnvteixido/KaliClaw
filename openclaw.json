{
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "<REDACTED_GATEWAY_TOKEN>"
    }
  },
  "agents": {
    "defaults": {
      "thinkingDefault": "max",
      "model": {
        "primary": "openrouter/thinkingmachines/inkling:free",
        "fallbacks": [
          "openrouter/cognitivecomputations/dolphin-mistral-24b-venice-edition:free"
